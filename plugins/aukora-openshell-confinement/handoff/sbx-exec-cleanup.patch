 #!/bin/bash
-# Root-owned (install 0755 root:root as /usr/local/lib/aukora-boundary/sbx-exec). The ONLY entry from the
-# harness user (aukora-host) to the agent's hands: runs ONE bash command inside the NVIDIA OpenShell sandbox
-# "auma-ws", owned by Linux user auma (rootless Podman, network mode none).
-# Usage (as auma, via the single sudo rule in sudoers.template): sbx-exec <timeout-seconds> <command-string>
-# Every call: (1) kills leftover processes from earlier calls, (2) runs the command with a per-process CPU-time
-# cap (ulimit -t) and a 20 MB file-size cap, (3) kills everything it left behind (detached/setsid children
-# included). Spared: PID 1, OpenShell's own login shell (the lowest-pid "/bin/bash -l" child of PID 1; killing
-# it puts the sandbox into Error) and processes of a call still running (an ancestor argv carries SKSBX).
-# Output goes to files so detached children cannot hold the exec pipe open past the cleanup; each stream is
-# capped at 1 MiB. The environment is fixed here; nothing from the caller's environment is trusted.
+# SPDX-License-Identifier: AGPL-3.0-or-later
+# SOURCE HANDOFF ONLY: Grok must add the applied-policy interface/check from
+# WRAPPER.md before this cleanup repair supports the plugin's execution route.
+# Keep the existing root-owned installation and single sudo rule.
 set -u
+umask 077
 uid=$(id -u)
 export HOME="$(getent passwd "$uid" | cut -d: -f6)" XDG_RUNTIME_DIR="/run/user/$uid" OPENSHELL_TELEMETRY_ENABLED=false PATH=/usr/local/bin:/usr/bin:/bin
