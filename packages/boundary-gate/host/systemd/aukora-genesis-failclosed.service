# Started only by aukora-selfcheck.service OnFailure: a forbidden action succeeded (or the check could not be recorded),
# so the runtime is stopped. It stays stopped: aukora-genesis's own ExecStartPre refuses to start it until the check passes.
[Unit]
Description=AUKORA fail closed: stop aukora-genesis after a failed boundary self-check

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl stop aukora-genesis.service
