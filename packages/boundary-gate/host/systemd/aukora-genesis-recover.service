# Recovery for aukora-genesis: restarts the SAME release only after the boundary checks pass.
# All logic lives in genesis-recover-probe (root-owned): quiet no-op while Genesis or the
# self-check is active/activating; never edits release.env; never switches releases.
[Unit]
Description=AUKORA Genesis recovery probe (restart only after self-check passes)
After=aukora-boundary-gate.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/lib/aukora-boundary/genesis-recover-probe
