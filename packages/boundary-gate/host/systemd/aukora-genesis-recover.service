# Recovery accepts only this helper's proven selfcheck failure-stop of the SAME release.
# A successful active startup latch is permitted; an executing selfcheck is not.
[Unit]
Description=AUKORA Genesis recovery probe (owned failure-stop only, same release)
After=aukora-boundary-gate.service

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/bin:/bin
UnsetEnvironment=NODE_OPTIONS NODE_PATH PYTHONPATH PYTHONHOME LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
TimeoutStartSec=600
ExecStart=/usr/bin/python3 -I -S /usr/local/lib/aukora-boundary/genesis-recover-probe recover
