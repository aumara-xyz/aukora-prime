# Gate as aukora-gate with primary group skgate, so /run/aukora-gate and the PROPOSE socket are group skgate
# (0750 / 0660) and the OWNER socket stays 0600. Replace SKGATE_GID with `getent group skgate | cut -d: -f3`.
[Unit]
Description=AUKORA lab: boundary gate (owner-only approvals, signed ledger and receipts)
After=network.target
[Service]
User=aukora-gate
Group=skgate
UMask=0027
RuntimeDirectory=aukora-gate
RuntimeDirectoryMode=0750
UnsetEnvironment=NODE_OPTIONS NODE_PATH PYTHONPATH PYTHONHOME LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
ExecStart=/usr/bin/python3 -I -S /usr/local/lib/aukora-boundary/gate-bootstrap serve --home /home/aukora-gate --run /run/aukora-gate --target-root /var/lib/aukora-boundary/targets --port 17792 --gid SKGATE_GID --time-zone Asia/Makassar --journal-id aukora-gate-pilot
Restart=on-failure
NoNewPrivileges=yes
[Install]
WantedBy=multi-user.target
