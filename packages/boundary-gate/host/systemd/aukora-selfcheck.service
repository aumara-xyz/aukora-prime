# Successful startup check stays active so Genesis can bind its lifetime to this unit.
# Periodic checks use aukora-selfcheck-periodic.service; a timer does not restart an active oneshot.
[Unit]
Description=AUKORA boundary self-check (harness user; stops aukora-genesis on failure)
# The bound startup job must wait for both providers pulled in by Genesis.
After=aukora-boundary-gate.service aukora-auma-sandbox.service
OnFailure=aukora-genesis-failclosed.service

[Service]
Type=oneshot
# A completed oneshot must stay 'active (exited)': aukora-genesis.service binds to this
# unit, and a dead state makes every later Genesis start lose the dependency race.
RemainAfterExit=yes
RemainAfterExit=yes
User=aukora-host
Group=aukora-host
UMask=0077
WorkingDirectory=/tmp
Environment=PATH=/usr/bin:/bin
# Check root-protected package bytes before Node; inherited loaders must not run before verification.
UnsetEnvironment=NODE_OPTIONS NODE_PATH PYTHONPATH PYTHONHOME LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
TimeoutStartSec=300
ExecStartPre=/usr/bin/python3 -I -S /usr/local/lib/aukora-boundary/gate-bootstrap check-runtime
ExecStart=/opt/aukora-node/bin/node /opt/aukora-boundary-gate/bin/selfcheck.mjs --run /run/aukora-gate --gate-home /home/aukora-gate --target-root /var/lib/aukora-boundary/targets --release-parent /opt/aukora-genesis --forbid-write /opt/aukora-boundary-gate/bin/gate.mjs --forbid-write /usr/local/lib/aukora-boundary/sbx-exec
