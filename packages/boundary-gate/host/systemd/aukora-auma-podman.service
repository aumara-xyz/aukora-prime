# Rootless Podman API for user auma. Requires `loginctl enable-linger auma` so /run/user/<auma uid> exists.
[Unit]
Description=AUKORA lab: rootless Podman API for auma
After=systemd-logind.service
[Service]
User=auma
Group=auma
ExecStart=/usr/local/lib/aukora-boundary/openshell/podman-service.sh
Restart=on-failure
[Install]
WantedBy=multi-user.target
