+
+/// Mark every non-stdio descriptor for closure on successful workload exec.
+///
+/// Keep temporary Landlock descriptors and Rust's private startup-error channel
+/// usable during pre-exec setup; neither may reach the workload image.
+#[cfg(target_os = "linux")]
+#[allow(unsafe_code)]
+pub(crate) fn mark_inherited_fds_close_on_exec() -> std::io::Result<()> {
+    // SAFETY: this allocation-free syscall changes only descriptor flags in the
+    // post-fork child's private descriptor table. It does not close stdio or
+    // the startup-error channel, and no pointers are passed to the kernel.
+    let result = unsafe {
+        libc::syscall(
+            libc::SYS_close_range,
+            3u32,
+            u32::MAX,
+            libc::CLOSE_RANGE_CLOEXEC,
+        )
+    };
+    if result < 0 {
+        Err(std::io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
 }
 
