+        binding.registration.workspace_source = "/srv/auma-ws/test-workspace".into();
+        binding.registration.git_source = "/srv/auma-ws/test-workspace/.git".into();
+        binding.registration.group_access = Some(GroupAccess { owner_uid: 7, group_gid: 23, guest_gid: 41 });
+        binding.registration.validate().unwrap();
+        binding.ensure_guest_gid(41).unwrap();
+        assert!(binding.ensure_guest_gid(42).is_err());
+        binding.registration.workspace_source = "/home/another/workspace".into();
+        binding.registration.git_source = "/home/another/workspace/.git".into();
+        assert!(binding.registration.validate().is_err());
+        binding.registration.version = 1;
+        assert!(binding.registration.validate().is_err());
+        // Linux-owned permission bits are checked directly. Mac may silently
+        // clear setgid on a disposable directory whose inherited group differs.
+        let mut identity = FileIdentity { device: 1, inode: 2, uid: 7, gid: 23, mode: 0o42770 };
+        let access = GroupAccess { owner_uid: 7, group_gid: 23, guest_gid: 41 };
+        for mode in [0o42750, 0o42770] {
+            identity.mode = mode;
+            assert!(group_source_identity(&identity, &access).is_ok());
+        }
+        let wrong_owner = GroupAccess { owner_uid: 8, group_gid: 23, guest_gid: 41 };
+        assert!(group_source_identity(&identity, &wrong_owner).is_err());
+        let wrong_group = GroupAccess { owner_uid: 7, group_gid: 24, guest_gid: 41 };
+        assert!(group_source_identity(&identity, &wrong_group).is_err());
+        for mode in [0o42777, 0o40770, 0o44770, 0o43750, 0o102770] {
+            identity.mode = mode;
+            assert!(group_source_identity(&identity, &access).is_err());
+        }
+    }
+
+    #[test]
+    fn no_follow_sources_refuse_symlink_and_shared_writable_directory() {
+        let root = std::env::temp_dir().canonicalize().unwrap().join(format!("openshell-binding-{}", uuid::Uuid::new_v4()));
+        std::fs::create_dir(&root).unwrap();
+        use std::os::unix::fs::{PermissionsExt, symlink};
+        std::fs::set_permissions(&root, std::fs::Permissions::from_mode(0o700)).unwrap();
+        let real = root.join("real"); std::fs::create_dir(&real).unwrap();
+        let alias = root.join("alias"); symlink(&real, &alias).unwrap();
+        // Exercise the actual no-follow openat leaf with a positive control.
+        // Full source ancestry intentionally refuses public writable /tmp.
+        let parent = File::open(&root).unwrap();
+        assert!(open_child(&parent, std::ffi::OsStr::new("real"), true).is_ok());
+        assert!(open_child(&parent, std::ffi::OsStr::new("alias"), true).is_err());
+        assert!(source_directory(&real.metadata().unwrap()).is_ok());
+        std::fs::set_permissions(&real, std::fs::Permissions::from_mode(0o777)).unwrap();
+        assert!(source_directory(&real.metadata().unwrap()).is_err());
+        assert!(open_anchored(real.to_str().unwrap(), true, false, None).is_err());
+        assert!(open_anchored(real.to_str().unwrap(), true, true, None).is_err());
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
