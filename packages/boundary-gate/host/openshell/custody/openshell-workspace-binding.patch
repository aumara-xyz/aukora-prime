+#[cfg(test)]
+mod original_cleanup_tests {
+    use super::*;
+
+    #[test]
+    fn original_cleanup_proof_accepts_exact_pair_and_refuses_changed_or_duplicate_mounts() {
+        let mut binding = TrustedWorkspaceBinding::synthetic();
+        binding.registration_identity = FileIdentity { device: 1, inode: 10, uid: 0, gid: 0, mode: 0o100644 };
+        let label = binding.label().unwrap();
+        let root = serde_json::json!({"Type":"bind","Source":binding.workspace_source(),"Destination":WORKSPACE_ROOT,"RW":true});
+        let git = serde_json::json!({"Type":"bind","Source":binding.git_source(),"Destination":GIT_ROOT,"RW":false});
+        let pair = vec![root.clone(), git.clone()];
+        assert!(verify_original_binding(&label, &pair).is_ok());
+        assert!(verify_original_binding(&label, &[root.clone()]).is_err());
+        assert!(verify_original_binding(&label, &[root.clone(), git.clone(), root.clone()]).is_err());
+        let mut changed = git.clone(); changed["RW"] = Value::Bool(true);
+        assert!(verify_original_binding(&label, &[root.clone(), changed]).is_err());
+        let mut changed = root.clone(); changed["Source"] = Value::String("/unowned".into());
+        assert!(verify_original_binding(&label, &[changed, git]).is_err());
+        let mut changed: Value = serde_json::from_str(&label).unwrap(); changed["caller"] = Value::Bool(true);
+        assert!(verify_original_binding(&changed.to_string(), &pair).is_err());
+        let duplicate = label.replacen("\"registration\":", "\"registration_identity\":{},\"registration\":", 1);
+        assert!(verify_original_binding(&duplicate, &pair).is_err());
+        binding.registration.version = 2;
+        binding.registration.workspace_source = "/srv/auma-ws/retained-unit".into();
+        binding.registration.git_source = "/srv/auma-ws/retained-unit/.git".into();
+        binding.registration.group_access = Some(GroupAccess { owner_uid: 7, group_gid: 23, guest_gid: 41 });
+        for identity in [&mut binding.workspace_identity, &mut binding.git_identity] {
+            identity.uid = 7; identity.gid = 23; identity.mode = 0o42770;
+        }
+        let group_label = binding.label().unwrap();
+        verify_original_binding_record(&group_label).unwrap();
+        for field in ["workspace_identity", "git_identity"] {
+            for (key, value) in [("uid", 8), ("gid", 24), ("mode", 0o42777), ("mode", 0o40770)] {
+                let mut changed: Value = serde_json::from_str(&group_label).unwrap();
+                changed[field][key] = Value::Number(value.into());
+                assert!(verify_original_binding_record(&changed.to_string()).is_err());
+            }
+        }
+        binding.registration.version = 1;
+        binding.registration.group_access = None;
+        assert!(verify_original_binding_record(&binding.label().unwrap()).is_err());
+    }
+}
