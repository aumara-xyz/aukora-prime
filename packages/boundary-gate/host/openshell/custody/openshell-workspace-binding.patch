+        let good = r#"{"version":1,"workspace_id":"6adab3d7-52db-4724-89bd-26a574e91d92","workspace_source":"/srv/reviewed/workspace","git_source":"/srv/reviewed/workspace/.git"}"#;
+        let registration: Registration = serde_json::from_str(good).unwrap();
+        registration.validate().unwrap();
+        for bad in [good.replace("\"version\":1", "\"version\":true"),
+            good.replace("\"version\":1", "\"version\":1,\"version\":1"),
+            good.replace("\"version\":1", "\"version\":1,\"caller_source\":\"/elsewhere\"")] {
+            assert!(serde_json::from_str::<Registration>(&bad).is_err());
+        }
+    }
+
+    #[test]
