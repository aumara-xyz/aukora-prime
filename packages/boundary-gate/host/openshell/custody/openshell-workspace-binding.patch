+#[derive(Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OriginalBinding {
+    registration: Registration,
+    registration_identity: FileIdentity,
+    workspace_identity: FileIdentity,
+    git_identity: FileIdentity,
+    #[serde(default)]
+    mirror_identity: Option<FileIdentity>,
+}
+
+/// Original backend custody is an ownership fence, not approval. Only trusted
+/// OwnedExecutor callers may enter lifecycle APIs; labels do not grant authority.
+fn original_binding(label: &str) -> Result<OriginalBinding, ComputeDriverError> {
+    if label.len() > 16384 { return Err(refused()); }
+    let original: OriginalBinding = serde_json::from_str(label).map_err(|_| refused())?;
+    original.registration.validate()?;
+    // Validate the original captured identities against their original versioned
+    // grant. Cleanup never reads mutable registration, permissions, ACLs or maps.
+    let regular = 0o100000;
+    let directory = 0o040000;
+    if original.registration_identity.uid != 0 ||
+        original.registration_identity.mode != (regular | 0o644) ||
+        [&original.workspace_identity, &original.git_identity].iter().any(|identity|
+            match original.registration.group_access.as_ref() {
+                Some(access) => group_source_identity(identity, access).is_err(),
+                None => identity.mode & 0o170000 != directory || identity.mode & 0o022 != 0,
+            }) {
+        return Err(refused());
+    }
+    if (original.workspace_identity.device, original.workspace_identity.inode) ==
+        (original.git_identity.device, original.git_identity.inode) { return Err(refused()); }
+    Ok(original)
+}
+
+pub(crate) fn verify_original_binding_record(label: &str) -> Result<(), ComputeDriverError> {
+    original_binding(label).map(|_| ())
+}
+
+#[cfg(test)]
+pub(crate) fn verify_original_binding(label: &str, mounts: &[Value]) -> Result<(), ComputeDriverError> {
+    let original = original_binding(label)?;
+    let mut root = 0; let mut git = 0;
+    for mount in mounts {
+        match mount["Destination"].as_str() {
+            Some(WORKSPACE_ROOT) => {
+                if mount["Type"].as_str() != Some("bind") || mount["RW"].as_bool() != Some(true) ||
+                    mount["Source"].as_str() != Some(original.registration.workspace_source.as_str()) { return Err(refused()); }
+                root += 1;
+            }
+            Some(GIT_ROOT) => {
+                if mount["Type"].as_str() != Some("bind") || mount["RW"].as_bool() != Some(false) ||
+                    mount["Source"].as_str() != Some(original.registration.git_source.as_str()) { return Err(refused()); }
+                git += 1;
+            }
+            _ => {}
+        }
+    }
+    if root != 1 || git != 1 { return Err(refused()); }
+    Ok(())
+}
