+// SPDX-License-Identifier: AGPL-3.0-or-later
+//! Fixed operator registration for the dedicated auma-ws create path.
+//!
+//! Registration custody is necessary, not approval or qualification. The root
+//! qualifier must join H's secret/hardlink/pre-bind review to these exact source
+//! identities before registering a snapshot. This reader cannot prove that scan,
+//! idmapped access, image qualification, or atomic mount realization occurred.
+
+use openshell_core::ComputeDriverError;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::ffi::CString;
+use std::fs::{File, Metadata, OpenOptions};
+use std::io::Read;
+use std::os::fd::{AsRawFd, FromRawFd};
+use std::os::unix::ffi::OsStrExt;
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+use std::path::{Component, Path};
+
+pub(crate) const REGISTRATION_PATH: &str = "/etc/aukora-boundary-gate/openshell-workspace.json";
+pub(crate) const BINDING_LABEL: &str = "openshell.ai/trusted-workspace-binding";
+pub(crate) const WORKSPACE_ROOT: &str = "/sandbox";
+pub(crate) const GIT_ROOT: &str = "/sandbox/.git";
+pub(crate) const MIRROR_ROOT: &str = "/sandbox/prime-main";
+const MAX_REGISTRATION_BYTES: u64 = 4096;
+
+fn open_mirror(path: &str) -> Result<File, ComputeDriverError> {
+    // Anchored no-follow open like the workspace pair, plus the mirror's own
+    // rule: the feed is root-owned and never group/other-writable, and its two
+    // pinned ancestors stay protected. Group read (auma-ws) is how the guest sees it.
+    let file = open_anchored(path, true, false, None)?;
+    for ancestor in ["/srv", "/srv/auma-mirror"] {
+        let meta = std::fs::metadata(ancestor).map_err(|_| refused())?;
+        protected_directory(&meta)?;
+    }
+    let meta = file.metadata().map_err(|_| refused())?;
+    if meta.uid() != 0 || meta.mode() & 0o022 != 0 { return Err(refused()); }
+    Ok(file)
+}
+
+fn refused() -> ComputeDriverError {
+    // Do not expose host source paths in guest-visible RPC diagnostics.
+    ComputeDriverError::Precondition("protected workspace registration unavailable".into())
+}
+
+#[derive(Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+struct Registration {
+    version: u32,
+    workspace_id: String,
+    workspace_source: String,
+    git_source: String,
+    #[serde(default, skip_serializing_if = "Option::is_none", deserialize_with = "deserialize_group_access")]
+    group_access: Option<GroupAccess>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    mirror_source: Option<String>,
+}
+
+#[derive(Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+struct GroupAccess {
+    owner_uid: u32,
+    group_gid: u32,
+    guest_gid: u32,
+}
+
+fn deserialize_group_access<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<Option<GroupAccess>, D::Error> {
+    // Missing legacy field defaults to None; explicit null is not an access grant.
+    GroupAccess::deserialize(deserializer).map(Some)
+}
+
+impl Registration {
+    fn validate(&self) -> Result<(), ComputeDriverError> {
+        let id = uuid::Uuid::parse_str(&self.workspace_id).map_err(|_| refused())?;
+        if id.is_nil() || id.hyphenated().to_string() != self.workspace_id {
+            return Err(refused());
+        }
+        match (self.version, self.group_access.as_ref()) {
+            (1, None) => (),
+            (2, Some(access)) if access.owner_uid > 0 && access.group_gid > 0 && access.guest_gid > 0 &&
+                Path::new(&self.workspace_source).parent() == Some(Path::new("/srv/auma-ws")) => (),
+            _ => return Err(refused()),
+        }
+        normalized_source(&self.workspace_source)?;
+        normalized_source(&self.git_source)?;
+        // A linked-worktree .git file or external common directory is not the
+        // approved directory pair. Never follow it or infer another source.
+        if self.git_source != format!("{}/.git", self.workspace_source) {
+            return Err(refused());
+        }
+        if let Some(mirror) = self.mirror_source.as_deref() {
+            // The mirror feed lives outside every agent-writable parent, as a
+            // dedicated root-owned sibling of the workspace, never inside it.
+            normalized_source(mirror)?;
+            if Path::new(mirror).parent() != Some(Path::new("/srv/auma-mirror")) ||
+                mirror == self.workspace_source || mirror == self.git_source ||
+                mirror.starts_with(&format!("{}/", self.workspace_source)) ||
+                self.workspace_source.starts_with(&format!("{}/", mirror)) {
+                return Err(refused());
+            }
+        }
+        Ok(())
+    }
+}
+
+fn normalized_source(value: &str) -> Result<(), ComputeDriverError> {
+    if !value.starts_with('/') || value == "/" || value.ends_with('/') ||
+        value.contains("//") || value != value.trim() || value.chars().any(char::is_control) ||
+        Path::new(value).components().any(|part| matches!(part, Component::CurDir | Component::ParentDir | Component::Prefix(_))) ||
+        value.split('/').any(|part| part == "." || part == "..") {
+        return Err(refused());
+    }
+    Ok(())
+}
+
+#[derive(Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+struct FileIdentity {
+    device: u64,
+    inode: u64,
+    uid: u32,
+    gid: u32,
+    mode: u32,
+}
+
+impl FileIdentity {
+    fn of(meta: &Metadata) -> Self {
+        Self { device: meta.dev(), inode: meta.ino(), uid: meta.uid(), gid: meta.gid(), mode: meta.mode() }
+    }
+}
+
+fn protected_directory(meta: &Metadata) -> Result<(), ComputeDriverError> {
+    if !meta.is_dir() || meta.uid() != 0 || meta.mode() & 0o022 != 0 { return Err(refused()); }
+    Ok(())
+}
+
+fn source_directory(meta: &Metadata) -> Result<(), ComputeDriverError> {
+    if !meta.is_dir() || meta.mode() & 0o022 != 0 { return Err(refused()); }
+    Ok(())
+}
+
+fn group_source_directory(meta: &Metadata, access: &GroupAccess) -> Result<(), ComputeDriverError> {
+    group_source_identity(&FileIdentity::of(meta), access)
+}
+
+fn group_source_identity(identity: &FileIdentity, access: &GroupAccess) -> Result<(), ComputeDriverError> {
+    // Only the protected registration's dedicated owner/group pair may share
+    // write access. Setgid preserves that group on newly created directories;
+    // other users, sticky/setuid modes and ordinary shared ancestors refuse.
+    if identity.mode & 0o170000 != 0o040000 || identity.uid != access.owner_uid || identity.gid != access.group_gid ||
+        !matches!(identity.mode & 0o7777, 0o2750 | 0o2770) { return Err(refused()); }
+    Ok(())
+}
+
+#[cfg(target_os = "linux")]
+fn no_source_acls(file: &File) -> Result<(), ComputeDriverError> {
+    for name in [c"system.posix_acl_access", c"system.posix_acl_default"] {
+        // SAFETY: this is a size query on an owned descriptor and constant
+        // NUL-terminated name; no memory is written. Any ACL grant refuses.
+        let size = unsafe { nix::libc::fgetxattr(file.as_raw_fd(), name.as_ptr(), std::ptr::null_mut(), 0) };
+        if size >= 0 { return Err(refused()); }
+        let error = std::io::Error::last_os_error().raw_os_error();
+        if error != Some(nix::libc::ENODATA) { return Err(refused()); }
+    }
+    Ok(())
+}
+
+#[cfg(not(target_os = "linux"))]
+fn no_source_acls(_file: &File) -> Result<(), ComputeDriverError> {
+    // This registration is a Linux runtime capability; another platform cannot
+    // qualify ACL absence by omitting the Linux observation.
+    Err(refused())
+}
+
+fn check_source_directory(file: &File, path: &Path, registration: Option<&Registration>) -> Result<(), ComputeDriverError> {
+    let meta = file.metadata().map_err(|_| refused())?;
+    if let Some(registration) = registration.filter(|r| r.group_access.is_some()) {
+        if path == Path::new(&registration.workspace_source) || path == Path::new(&registration.git_source) {
+            group_source_directory(&meta, registration.group_access.as_ref().ok_or_else(refused)?)?;
+            return no_source_acls(file);
+        }
+        // Dedicated group write never permits a writable or non-root ancestor.
+        return protected_directory(&meta);
+    }
+    source_directory(&meta)
+}
+
+fn open_child(parent: &File, name: &std::ffi::OsStr, directory: bool) -> Result<File, ComputeDriverError> {
+    let name = CString::new(name.as_bytes()).map_err(|_| refused())?;
+    let flags = nix::libc::O_RDONLY | nix::libc::O_NOFOLLOW | nix::libc::O_CLOEXEC |
+        if directory { nix::libc::O_DIRECTORY } else { nix::libc::O_NONBLOCK };
+    // SAFETY: parent is an owned directory FD, name is NUL-terminated, and
+    // no creation flags are used. The descriptor is transferred exactly once.
+    let raw = unsafe { nix::libc::openat(parent.as_raw_fd(), name.as_ptr(), flags) };
+    if raw < 0 { return Err(refused()); }
+    // SAFETY: openat returned one new valid descriptor, now owned by File.
+    Ok(unsafe { File::from_raw_fd(raw) })
+}
+
+fn open_anchored(path: &str, directory: bool, protected: bool, registration: Option<&Registration>) -> Result<File, ComputeDriverError> {
+    normalized_source(path)?;
+    let mut parent = OpenOptions::new().read(true)
+        .custom_flags(nix::libc::O_DIRECTORY | nix::libc::O_NOFOLLOW | nix::libc::O_CLOEXEC)
+        .open("/").map_err(|_| refused())?;
+    let parts: Vec<_> = Path::new(path).components().filter_map(|part| {
+        if let Component::Normal(value) = part { Some(value) } else { None }
+    }).collect();
+    let mut current = std::path::PathBuf::from("/");
+    for (index, part) in parts.iter().enumerate() {
+        let before = parent.metadata().map_err(|_| refused())?;
+        if protected { protected_directory(&before)?; }
+        check_source_directory(&parent, &current, registration)?;
+        let leaf = index + 1 == parts.len();
+        parent = open_child(&parent, part, !leaf || directory)?;
+        current.push(part);
+    }
+    let meta = parent.metadata().map_err(|_| refused())?;
+    if directory {
+        check_source_directory(&parent, &current, registration)?;
+    } else if !meta.is_file() || meta.mode() & 0o022 != 0 {
+        return Err(refused());
+    }
+    if protected && (meta.uid() != 0 || meta.mode() & 0o777 != 0o644) { return Err(refused()); }
+    Ok(parent)
+}
+
+fn read_registration_file(mut file: File) -> Result<(Registration, FileIdentity, File), ComputeDriverError> {
+    let before = file.metadata().map_err(|_| refused())?;
+    if before.len() > MAX_REGISTRATION_BYTES { return Err(refused()); }
+    let mut bytes = Vec::new();
+    Read::by_ref(&mut file).take(MAX_REGISTRATION_BYTES + 1).read_to_end(&mut bytes).map_err(|_| refused())?;
+    let after = file.metadata().map_err(|_| refused())?;
+    if bytes.len() as u64 > MAX_REGISTRATION_BYTES || FileIdentity::of(&before) != FileIdentity::of(&after) ||
+        before.len() != after.len() || before.mtime() != after.mtime() || before.mtime_nsec() != after.mtime_nsec() ||
+        before.ctime() != after.ctime() || before.ctime_nsec() != after.ctime_nsec() { return Err(refused()); }
+    let registration: Registration = serde_json::from_slice(&bytes).map_err(|_| refused())?;
+    registration.validate()?;
+    Ok((registration, FileIdentity::of(&after), file))
+}
+
+fn read_registration() -> Result<(Registration, FileIdentity, File), ComputeDriverError> {
+    read_registration_file(open_anchored(REGISTRATION_PATH, false, true, None)?)
+}
+
+#[derive(Debug)]
+pub(crate) struct TrustedWorkspaceBinding {
+    registration: Registration,
+    registration_identity: FileIdentity,
+    workspace_identity: FileIdentity,
+    git_identity: FileIdentity,
+    mirror_identity: Option<FileIdentity>,
+    // Hold the measured inodes until create finishes. Podman still consumes
+    // pathnames; repeated custody checks do not claim atomic launch fencing.
+    _anchors: Vec<File>,
+}
+
+impl TrustedWorkspaceBinding {
+    pub(crate) fn load(name: &str, workspace: &str) -> Result<Self, ComputeDriverError> {
+        if name != "auma-ws" || workspace != "default" { return Err(refused()); }
+        let (registration, registration_identity, file) = read_registration()?;
+        if registration.group_access.as_ref().is_some_and(|access| access.owner_uid != nix::unistd::geteuid().as_raw()) {
+            return Err(refused());
+        }
+        let source = open_anchored(&registration.workspace_source, true, false, Some(&registration))?;
+        let git = open_anchored(&registration.git_source, true, false, Some(&registration))?;
+        let workspace_identity = FileIdentity::of(&source.metadata().map_err(|_| refused())?);
+        let git_identity = FileIdentity::of(&git.metadata().map_err(|_| refused())?);
+        let mirror = registration.mirror_source.as_deref().map(open_mirror).transpose()?;
+        let mirror_identity = match mirror.as_ref() {
+            Some(file) => Some(FileIdentity::of(&file.metadata().map_err(|_| refused())?)),
+            None => None,
+        };
+        let mut anchors = vec![file, source, git];
+        if let Some(file) = mirror { anchors.push(file); }
+        let binding = Self {
+            registration, registration_identity,
+            workspace_identity,
+            git_identity,
+            mirror_identity,
+            _anchors: anchors,
+        };
+        binding.recheck()?;
+        Ok(binding)
+    }
+
+    pub(crate) fn workspace_source(&self) -> &str { &self.registration.workspace_source }
+    pub(crate) fn git_source(&self) -> &str { &self.registration.git_source }
+    pub(crate) fn mirror_source(&self) -> Option<&str> { self.registration.mirror_source.as_deref() }
+
+    pub(crate) fn ensure_guest_gid(&self, gid: u32) -> Result<(), ComputeDriverError> {
+        if self.registration.group_access.as_ref().is_some_and(|access| access.guest_gid != gid) { return Err(refused()); }
+        Ok(())
+    }
+
+    pub(crate) fn identity(&self) -> Value {
+        serde_json::json!({
+            "registration": self.registration,
+            "registration_identity": self.registration_identity,
+            "workspace_identity": self.workspace_identity,
+            "git_identity": self.git_identity,
+            "mirror_identity": self.mirror_identity,
+        })
+    }
+
+    pub(crate) fn label(&self) -> Result<String, ComputeDriverError> {
+        serde_json::to_string(&self.identity()).map_err(|_| refused())
+    }
+
+    pub(crate) fn recheck(&self) -> Result<(), ComputeDriverError> {
+        // An in-place root rewrite can preserve dev/ino/mode. Reread the strict
+        // versioned content under the same custody fence before each effect.
+        let (registration, identity, _file) = read_registration()?;
+        if registration != self.registration || identity != self.registration_identity { return Err(refused()); }
+        for (path, expected, directory, protected) in [
+            (self.workspace_source(), &self.workspace_identity, true, false),
+            (self.git_source(), &self.git_identity, true, false),
+        ] {
+            let file = open_anchored(path, directory, protected, Some(&self.registration))?;
+            if FileIdentity::of(&file.metadata().map_err(|_| refused())?) != *expected { return Err(refused()); }
+        }
+        if let (Some(mirror), Some(expected)) = (self.mirror_source(), &self.mirror_identity) {
+            let file = open_mirror(mirror)?;
+            if FileIdentity::of(&file.metadata().map_err(|_| refused())?) != *expected { return Err(refused()); }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn admits_mount(&self, mount: &Value) -> bool {
+        let expected = match mount.get("Destination").and_then(Value::as_str) {
+            Some(WORKSPACE_ROOT) => Some((self.workspace_source(), true)),
+            Some(GIT_ROOT) => Some((self.git_source(), false)),
+            Some(MIRROR_ROOT) => match self.mirror_source() {
+                Some(source) => Some((source, false)),
+                None => return false,
+            },
+            _ => None,
+        };
+        expected.is_some_and(|(source, writable)|
+            mount.get("Type").and_then(Value::as_str) == Some("bind") &&
+            mount.get("Source").and_then(Value::as_str) == Some(source) &&
+            mount.get("RW").and_then(Value::as_bool) == Some(writable))
+    }
+
+    #[cfg(test)]
+    pub(crate) fn synthetic() -> Self {
+        let directory = |inode| FileIdentity { device: 1, inode, uid: 7, gid: 7, mode: 0o40700 };
+        Self { registration: Registration { version: 1,
+            workspace_id: "6adab3d7-52db-4724-89bd-26a574e91d92".into(),
+            workspace_source: "/srv/reviewed/workspace".into(),
+            git_source: "/srv/reviewed/workspace/.git".into(), group_access: None },
+            registration_identity: FileIdentity { device: 1, inode: 1, uid: 0, gid: 0, mode: 0o100644 }, workspace_identity: directory(2), git_identity: directory(3), _anchors: Vec::new() }
+    }
+}
+
