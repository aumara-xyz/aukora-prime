+        let mut binding = TrustedWorkspaceBinding::synthetic();
+        binding.registration.validate().unwrap();
+        binding.registration.workspace_id = "default".into();
+        assert!(binding.registration.validate().is_err());
+        for source in ["relative", "/srv/../workspace", "/srv//workspace", "/srv/./workspace", "/srv/workspace/"] {
+            assert!(normalized_source(source).is_err());
+        }
+        binding.registration.workspace_id = "6adab3d7-52db-4724-89bd-26a574e91d92".into();
+        binding.registration.git_source = "/srv/outside/common.git".into();
+        assert!(binding.registration.validate().is_err());
+        assert!(TrustedWorkspaceBinding::load("another", "default").is_err());
+        assert!(TrustedWorkspaceBinding::load("auma-ws", "other").is_err());
+    }
+
+    #[test]
+    fn only_the_registered_pair_and_exact_rw_types_are_admitted() {
+        let binding = TrustedWorkspaceBinding::synthetic();
+        let root = serde_json::json!({"Type":"bind","Destination":"/sandbox","Source":"/srv/reviewed/workspace","RW":true});
+        let git = serde_json::json!({"Type":"bind","Destination":"/sandbox/.git","Source":"/srv/reviewed/workspace/.git","RW":false});
+        assert!(binding.admits_mount(&root));
+        assert!(binding.admits_mount(&git));
+        for (key, value) in [("Type", Value::String("volume".into())),
+            ("Source", Value::String("/srv/other".into())), ("Destination", Value::String("/second-root".into())),
+            ("RW", Value::Bool(false)), ("RW", Value::Number(1.into()))] {
+            let mut changed = root.clone(); changed[key] = value;
+            assert!(!binding.admits_mount(&changed));
+        }
+        let mut writable_git = git; writable_git["RW"] = Value::Bool(true);
+        assert!(!binding.admits_mount(&writable_git));
+    }
