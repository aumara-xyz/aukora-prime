#!/bin/sh
set -eu
prime_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1-}" in
    up|down|example)
        if ! command -v python3 >/dev/null 2>&1; then
            printf 'UNPERFORMED: python3-unavailable\n'
            exit 2
        fi
        ;;
esac
case "${1-}" in
    up|down)
        exec python3 -B "$prime_root/scripts/prime-example.py" "$@"
        ;;
    example)
        shift
        exec python3 -B "$prime_root/scripts/prime-example.py" "$@"
        ;;
esac
exec node "$prime_root/harness/cli.mjs" "$@"

