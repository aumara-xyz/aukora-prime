[Unit]
Description=AUKORA: Buzz relay with its own Postgres and Redis (rootless pod, loopback only)
After=network-online.target user@@UID@.service
Requires=user@@UID@.service
Wants=network-online.target aukora-buzz-watch.timer

[Service]
Type=oneshot
RemainAfterExit=yes
User=aukora-buzz
Group=aukora-buzz
# Keep files created by the launch/stop scripts private to the service account.
UMask=0077
# Keep Podman's UID/GID helpers usable; deny unused host hardware, clock and kernel-log powers.
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_TIME CAP_SYSLOG CAP_WAKE_ALARM
WorkingDirectory=/var/lib/aukora-buzz
Environment=AUKORA_BUZZ_MEMORY_LIMITS=@MEMORY_LIMITS@
ExecStart=/usr/local/lib/aukora-buzz/up.sh
ExecStop=/usr/local/lib/aukora-buzz/down.sh
# Also after a start that failed part-way, so no container is left running behind a failed unit.
ExecStopPost=/usr/local/lib/aukora-buzz/down.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
