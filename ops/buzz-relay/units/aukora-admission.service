[Unit]
Description=AUKORA invite admission to the closed Buzz relay
After=network.target aukora-buzz.service
Requires=aukora-buzz.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=aukora-admission
Group=aukora-admission
Environment=HOME=/var/lib/aukora-admission
UnsetEnvironment=NODE_OPTIONS NODE_PATH LD_PRELOAD LD_LIBRARY_PATH LD_AUDIT
UMask=0077
WorkingDirectory=/usr/local/lib/aukora-buzz/member
ExecStart=/usr/local/lib/aukora-buzz/node-v24.11.1/node /usr/local/lib/aukora-buzz/member/ops/buzz-relay/admission-server.mjs --key-file /var/lib/aukora-admission/owner.key --store /var/lib/aukora-admission/store --host 127.0.0.1 --port 3100 --relay http://localhost:@RELAY_PORT@
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/aukora-admission
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
MemoryMax=256M
TasksMax=32
LimitNOFILE=256
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
