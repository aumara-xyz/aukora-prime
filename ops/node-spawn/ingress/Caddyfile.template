# Only the configured application and owner hosts reach loopback services.

(aukora_headers) {
	header Strict-Transport-Security "max-age=31536000__HSTS_INCLUDE_SUBDOMAINS__"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "no-referrer"
	request_body {
		max_size 8MB
	}
}

# BEGIN AUKORA NODE
# Node __NODE_NAME__: these hostnames route only to this node's three ports.
https://__APP_HOST__ {
	import aukora_headers

	@launch_token query token=*
	# Inside a handle block: Caddy runs handle before a bare respond, so a bare one never fires here.
	handle @launch_token {
		respond 404
	}

	@claim path /__aukora/claim /__aukora/claim.js /__aukora/signin /__aukora/signin.js /__aukora/signout
	handle @claim {
		reverse_proxy 127.0.0.1:__CLAIM_PORT__ {
			flush_interval -1
			header_up -Forwarded
			header_up -X-Forwarded-*
			header_up Host {http.request.host}
			# Origin, Cookie and Fetch Metadata pass through untouched: restating one sets it to an empty value
			# when the browser sent none, and the node rightly refuses an Origin that is not its own.
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy 127.0.0.1:__HARNESS_PORT__ {
			flush_interval -1
			header_up -Forwarded
			header_up -X-Forwarded-*
			header_up Host {http.request.host}
			# Origin, Cookie and Fetch Metadata pass through untouched: restating one sets it to an empty value
			# when the browser sent none, and the node rightly refuses an Origin that is not its own.
			header_up X-Forwarded-For {http.request.remote.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Forwarded-Proto https
		}
	}
}

https://__OWNER_HOST__ {
	import aukora_headers
	header X-Frame-Options "DENY"
	reverse_proxy 127.0.0.1:__OWNER_PORT__ {
		flush_interval -1
		header_up -Forwarded
		header_up -X-Forwarded-*
		header_up Host {http.request.host}
		# Origin, Cookie and Fetch Metadata pass through untouched: restating one sets it to an empty value
		# when the browser sent none, and the node rightly refuses an Origin that is not its own.
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto https
	}
}

http://__APP_HOST__ {
	@launch_token query token=*
	handle @launch_token {
		respond 404
	}
	handle {
		redir https://__APP_HOST__{path} permanent
	}
}

http://__OWNER_HOST__ {
	@launch_token query token=*
	handle @launch_token {
		respond 404
	}
	handle {
		redir https://__OWNER_HOST__{path} permanent
	}
}
# END AUKORA NODE

:80, :443 {
	abort
}

